<idea-plugin>
    <id>com.example.hotreload</id>
    <name>Hot-Reload Agent</name>
    <version>1.0.0-SNAPSHOT</version>
    <vendor email="support@example.com" url="https://github.com/devalgoz/hot-reload-agent">Example</vendor>

    <description><![CDATA[
    Hot-Reload Agent IntelliJ plugin. Compiles Java sources on save and pushes
    the resulting class bytes to a running JVM via the Hot-Reload Agent.
    ]]></description>

    <change-notes><![CDATA[
    Initial release.
    ]]></change-notes>

    <idea-version since-build="241.0" until-build="242.*"/>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Compiler listener hook will go here -->
    </extensions>

    <actions>
        <action id="hotreload.compileAndReload"
                class="com.example.hotreload.intellij.HotReloadAction"
                text="Compile and Hot-Reload"
                description="Compiles changed sources and pushes class bytes to the running agent">
            <add-to-group group-id="CompilerMenu" anchor="last"/>
            <add-to-group group-id="BuildMenu" anchor="last"/>
            <keyboard-shortcut first-keystroke="ctrl shift R" keymap="$default"/>
        </action>
    </actions>

    <project-components>
        <!-- Project-level component for watcher integration will go here -->
    </project-components>
</idea-plugin>
