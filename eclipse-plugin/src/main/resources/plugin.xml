<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension-point id="hotReloadBuilder" name="Hot-Reload Builder"/>
    
    <extension point="org.eclipse.core.resources.builders">
        <builder
            id="com.example.hotreload.eclipse.hotReloadBuilder"
            name="Hot-Reload Builder"
            class="com.example.hotreload.eclipse.HotReloadBuilder">
        </builder>
    </extension>
    
    <extension point="org.eclipse.ui.actionSets">
        <actionSet
            label="Hot-Reload Agent"
            visible="true"
            id="com.example.hotreload.eclipse.actionSet">
            <action
                label="Compile and Hot-Reload"
                icon="icons/full/obj16/compile.gif"
                class="com.example.hotreload.eclipse.HotReloadAction"
                tooltipText="Compiles and hot-reloads changed classes"
                menubarPath="org.eclipse.ui.main.menu/build"
                id="com.example.hotreload.eclipse.actions.HotReloadAction">
            </action>
        </actionSet>
    </extension>
</plugin>
